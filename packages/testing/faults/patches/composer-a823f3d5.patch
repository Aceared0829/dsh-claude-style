+/* ---------- the transcript pane's own axes ---------- */
+/* Content a couple of pixels too wide — a wide inline atom, a rounded
+   `calc()`, scrollbar-gutter's rounding — grows a horizontal scrollbar on the
+   pane, which the reader meets as a bar under the composer on a card narrower
+   than the transcript. What must scroll sideways inside the transcript (code
+   blocks, tables) carries its own overflow-x, so the pane's x-axis is clipped
+   rather than scrollable; the process body takes the same decision in
+   features/chat-follow/chat-follow.css. The y-axis stays the host's, which is
+   what every follow and scroll owner reads. */
+body[data-dsh-claude-style] [data-conversation-scroll] {
+  overflow-x: hidden;
+}
+
